# ---------------------------------------------------------------- Bagisto
# The app runs without these — drafting works anonymously against localStorage.
# They are required for accounts, server-side documents, the advocate desk and
# purchase.
#
# One database. Bagisto owns customers, orders, invoices and payments; the legal
# domain lives beside them in `legal_`-prefixed tables. These are the same values as
# Bagisto's own DB_* settings.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bagisto

# Where Bagisto is served. Used for sign-in and for the checkout hand-off — the two
# things the application asks Bagisto to do rather than doing itself.
BAGISTO_URL=http://localhost

# Shared with Bagisto: must match LEGAL_API_SECRET in its .env.
#
# It guards POST /api/legal/mail/send, which takes a recipient, a subject and a body
# and sends from the firm's address. Left unguarded that is a mail relay wearing a law
# firm's name, so the endpoint refuses outright when this is unset.
LEGAL_API_SECRET=

# ---------------------------------------------------------------- Khalti
# NOT CURRENTLY USED. Bagisto owns checkout, and no Nepali gateway extension is
# installed in it yet. These remain because lib/payments/khalti.ts is the starting
# point for a Bagisto payment extension, and its verification logic is worth keeping.
#
# ePay v2. Primary rail: cleanest API of the three, and its sandbox behaves like
# production. Amounts are sent in PAISA.
KHALTI_SECRET_KEY=
# "live" uses a.khalti.com; anything else uses the dev.khalti.com sandbox.
KHALTI_ENV=sandbox

# ---------------------------------------------------------------- eSewa
# NOT CURRENTLY USED — see the note above Khalti.
#
# ePay v2. Widest reach. Takes a signed form POST, not a redirect, and quotes amounts
# in RUPEES — the opposite of Khalti. Signature is HMAC-SHA256 over the fields named
# in signed_field_names, in that exact order.
ESEWA_SECRET_KEY=
ESEWA_PRODUCT_CODE=
# "live" uses epay.esewa.com.np; anything else uses the rc-epay test host.
ESEWA_ENV=test

# ---------------------------------------------------------------- App
# The public origin. Must be the real one in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- Contract review
# The model only EXTRACTS facts from a pasted contract; the legal judgement is made
# by deterministic rules in lib/review/rules.ts against the constants in lib/nepal.ts.
# That split is why a statutory citation shown to a user can never be hallucinated —
# and it holds whichever model runs, because the schema the model fills in has no
# field for a statute, an opinion, or a risk level.
#
# What a weaker model DOES put at risk is the accuracy of the numbers, which is a
# subtler failure rather than a smaller one: a misread wage gets a perfectly real
# citation attached, and looks exactly as authoritative as a correct finding. Compare
# a real contract across two models before trusting either.
#
# Option 1 — any OpenAI-compatible endpoint (takes precedence when all three are set).
# Nous Portal, for example, speaks this protocol:
#   REVIEW_API_BASE_URL=https://inference-api.nousresearch.com/v1
# Its model list is public, no key needed:
#   curl -s https://inference-api.nousresearch.com/v1/models
REVIEW_API_BASE_URL=
REVIEW_API_KEY=
REVIEW_MODEL=

# Option 2 — Anthropic directly. Used when the three above are not all set.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Reconciliation
# Shared secret for POST /api/payment/reconcile, which turns paid invoices into
# entitlements and drains the notification queue. Call it on a schedule (every few
# minutes). Without it the route refuses rather than running unauthenticated.
RECONCILE_SECRET=
